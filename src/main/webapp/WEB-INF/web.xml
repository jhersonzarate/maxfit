<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>MaxFit Web</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ═══════════════════════════════════════
        ENCODING UTF-8 global
   ════════════════════════════════ -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.mycompany.herramientas.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <!-- ═══════════════════════════════════════
         FILTROS
    ════════════════════════════════════════ -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.mycompany.herramientas.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.mycompany.herramientas.filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.mycompany.herramientas.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ═══════════════════════════════════════
         SERVLETS
    ════════════════════════════════════════ -->
    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.ForgotPasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordController</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InicioController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.InicioController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InicioController</servlet-name>
        <url-pattern>/inicio</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.DashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardController</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InstructorController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.InstructorController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InstructorController</servlet-name>
        <url-pattern>/instructor</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClientsController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.ClientsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClientsController</servlet-name>
        <url-pattern>/clients</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MembershipsController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.MembershipsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MembershipsController</servlet-name>
        <url-pattern>/memberships</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ContractsController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.ContractsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContractsController</servlet-name>
        <url-pattern>/contracts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttendanceController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.AttendanceController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceController</servlet-name>
        <url-pattern>/attendance</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SchedulesController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.SchedulesController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SchedulesController</servlet-name>
        <url-pattern>/schedules</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SchedulesController</servlet-name>
        <url-pattern>/calendar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeesController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.EmployeesController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeesController</servlet-name>
        <url-pattern>/employees</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UsersController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.UsersController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsersController</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportsController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.ReportsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportsController</servlet-name>
        <url-pattern>/reports</url-pattern>
    </servlet-mapping>

    <servlet>
