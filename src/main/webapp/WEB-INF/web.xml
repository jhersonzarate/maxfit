        <servlet-class>com.mycompany.herramientas.controller.PaymentMethodsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentMethodsController</servlet-name>
        <url-pattern>/payment-methods</url-pattern>
    </servlet-mapping>

    <!-- ── CATÁLOGOS: Cargos, TipoClase, TipoDocumento ── -->
    <servlet>
        <servlet-name>CargoController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.CargoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CargoController</servlet-name>
        <url-pattern>/cargo</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TipoClaseController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.TipoClaseController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TipoClaseController</servlet-name>
        <url-pattern>/tipoclase</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TipoDocumentoController</servlet-name>
        <servlet-class>com.mycompany.herramientas.controller.TipoDocumentoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TipoDocumentoController</servlet-name>
        <url-pattern>/tipodocumento</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════════════════════════
         SESIÓN — 30 minutos de inactividad
    ════════════════════════════════════════ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>



</web-app>